# systemd unit for `tenjin gateway` (Linux).
# Install:  cp ops/tenjin.service ~/.config/systemd/user/
#           systemctl --user daemon-reload
#           systemctl --user enable --now tenjin
# Secrets:  EnvironmentFile below (0600), never inline — see ops/gateway.env.example
# Logs:     journalctl --user -u tenjin -f

[Unit]
Description=Tenjin personal agent gateway
After=network-online.target

[Service]
ExecStart=/usr/bin/env bun run /path/to/stealth/src/index.ts gateway
WorkingDirectory=/path/to/stealth
Restart=on-failure
RestartSec=5
EnvironmentFile=/your/home/.tenjin/gateway.env

[Install]
WantedBy=default.target
