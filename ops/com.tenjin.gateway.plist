<!-- macOS launchd job for `tenjin gateway`.
     Install:
       cp ops/com.tenjin.gateway.plist ~/Library/LaunchAgents/
       cp ops/tenjin-launchd.sh /path/to/tenjin-launchd.sh
       chmod +x /path/to/tenjin-launchd.sh
       launchctl load ~/Library/LaunchAgents/com.tenjin.gateway.plist
     Secrets: loaded by tenjin-launchd.sh from ~/.tenjin/gateway.env (0600),
              never inline here — see ops/gateway.env.example.
     Logs:    absolute, under the gateway home so launchd resolves them
              regardless of the job's working directory.
-->
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.tenjin.gateway</string>
  <key>ProgramArguments</key>
  <array>
    <string>/path/to/tenjin-launchd.sh</string>
  </array>
  <key>WorkingDirectory</key><string>/path/to/stealth</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/your/home/.tenjin/gateway.log</string>
  <key>StandardErrorPath</key><string>/your/home/.tenjin/gateway.log</string>
</dict>
</plist>
