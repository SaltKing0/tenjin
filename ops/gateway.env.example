# Copy to ~/.tenjin/gateway.env and `chmod 600` it. Never commit real secrets.
# Both the launchd wrapper (ops/tenjin-launchd.sh) and the systemd unit
# (ops/tenjin.service) read this file. Keys you don't use can be left empty.
#
# Gateway REST/console token — MUST match `gateway.listen.token` in config.yaml.
GATEWAY_TOKEN=

# Provider API keys (the harness can also read these from providers.yaml).
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Channel tokens (only needed for the channels you enable in config.yaml).
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE=
DISCORD_BOT_TOKEN=
DISCORD_API_BASE=
DISCORD_GATEWAY_URL=

# Optional overrides.
TENJIN_HOME=
