# Copy to .env and fill in. Never commit real secrets.
# Gateway REST/console token — MUST match `gateway.listen.token` in config.yaml.
GATEWAY_TOKEN=dev-local-token

# Host port to expose the gateway on (container is always 3000).
TENJIN_PORT=3000

# Provider API keys (optional; the harness can also read them from providers.yaml
# in the home volume).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Channel tokens (only needed for the channels you enable in config.yaml).
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE=
