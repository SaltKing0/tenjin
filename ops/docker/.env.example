# Copy to .env and fill in. Never commit real secrets.
# Gateway REST/console token — REQUIRED. Must equal `gateway.listen.token` in
# config.yaml. NO default: entrypoint.sh refuses to boot with an unset or
# example token, so generate a strong, unique value before `docker compose up`.
#   e.g.  openssl rand -hex 32
GATEWAY_TOKEN=

# Host bind + port to expose the gateway on (container is always 3000).
# The host bind defaults to 127.0.0.1 (#239) so nothing is exposed publicly by
# default. Only set TENJIN_BIND=0.0.0.0 to publish it — and do so behind a
# reverse proxy with TLS, never directly on the open internet.
TENJIN_BIND=127.0.0.1
TENJIN_PORT=3000

# Provider API keys (optional; the harness can also read them from providers.yaml
# in the home volume).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Channel tokens (only needed for the channels you enable in config.yaml).
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE=
